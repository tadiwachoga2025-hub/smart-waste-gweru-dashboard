# Copy to .env and fill in. .env must never be committed.
# Gmail: enable 2-Step Verification, then create an App Password
# (https://myaccount.google.com/apppasswords) and paste it below (16 chars, no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
# Optional, defaults to SMTP_USER
SMTP_FROM=SmartWaste Alerts <you@gmail.com>
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
# Fallback recipients (comma separated) when settings/alerts has none
ALERT_TO=operator1@example.com,operator2@example.com
# Link shown in the email; omit to hide the link
DASHBOARD_URL=https://your-dashboard.example.com
