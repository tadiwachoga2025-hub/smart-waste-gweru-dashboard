      ],
      "$aid": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'active' && !data.exists() && newData.child('actorUid').val() === auth.uid && newData.child('actorRole').val() === root.child('users').child(auth.uid).child('role').val() && newData.child('actorName').val() === root.child('users').child(auth.uid).child('name').val() && newData.child('at').val() === now && (root.child('users').child(auth.uid).child('role').val() !== 'citizen' || ['complaint.submit', 'auth.signout'].contains(newData.child('action').val()))",
        ".validate": "newData.hasChildren(['at', 'actorUid', 'actorRole', 'action'])",
        "actorName": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "action": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "target": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "detail": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
