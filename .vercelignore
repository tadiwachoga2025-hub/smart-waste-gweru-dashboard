# Never upload server credentials or local tooling with CLI deploys.
*-firebase-adminsdk-*.json
.env
.env.*
# Every local credential file: device-credentials.local (the device password
# and refresh token), demo-accounts.local, .env.local. Git ignores these, but
# the CLI uploads the working tree, not the index.
*.local
.venv
__pycache__
*.pyc
engine.py
notifier.py
requirements.txt
